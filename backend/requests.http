@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VybmFtZSI6ImNodW5reWxvdmVyMjMiLCJpYXQiOjE3NzM3MDU5MjMsImV4cCI6MTc3Mzc5MjMyM30.oOpsp-9hUg_sB_ocLP0oa19zwlE1BRXWw6CekDzRU0Q

### Get all images (unauthorized - should 401)
GET http://localhost:3000/api/images

### Get all images (authorized)
GET http://localhost:3000/api/images
Authorization: Bearer {{token}}

### Get one image by id
GET http://localhost:3000/api/images/69af1877a4ffe45046720e23
Authorization: Bearer {{token}}

### Rename image (success)
PATCH http://localhost:3000/api/images/69af1877a4ffe45046720e23/name
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "New image name" }

### Rename image (bad request - missing name)
PATCH http://localhost:3000/api/images/69af1877a4ffe45046720e23/name
Content-Type: application/json
Authorization: Bearer {{token}}

{ "title": "Missing name field" }

### Rename image (not found - invalid id)
PATCH http://localhost:3000/api/images/not-a-valid-id/name
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "Will not work" }

### Rename image (content too large)
PATCH http://localhost:3000/api/images/69af1877a4ffe45046720e23/name
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "This name is way too longggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg" }

### A second example.  Each request **MUST** be delimited by a triple hash
POST http://localhost:3000/api/test
Content-Type: application/json # Content-Type header is a must if you're sending JSON
# Request body separated from headers by newline

{ "a": 1, "b": 2 }

### Register user (success)
POST http://localhost:3000/api/users
Content-Type: application/json

{ "username": "chunkylover23", "email": "chunkylover23@example.com", "password": "password" }

### Register user (conflict - username taken)
POST http://localhost:3000/api/users
Content-Type: application/json

{ "username": "hannah", "email": "hannah2@example.com", "password": "password" }

### Register user (bad request - missing password)
POST http://localhost:3000/api/users
Content-Type: application/json

{ "username": "missing", "email": "missing@example.com" }

### Login (success)
POST http://localhost:3000/api/auth/tokens
Content-Type: application/json

{ "username": "hannah", "password": "password" }

### Login (unauthorized - bad password)
POST http://localhost:3000/api/auth/tokens
Content-Type: application/json

{ "username": "hannah", "password": "wrong" }

### Login (bad request - missing password)
POST http://localhost:3000/api/auth/tokens
Content-Type: application/json

{ "username": "hannah" }
